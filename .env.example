# Copy to .env and adjust for your environment.
# Spring Boot reads these when you run: docker run --env-file .env ...
# Or use docker compose (see docker-compose.yml if added).

# --- Profile (optional) ---
# Use prod for remote DB settings in application-prod.yml
# SPRING_PROFILES_ACTIVE=prod

# --- Server ---
SERVER_PORT=8082
VERIFY_EMAIL_HOST=https://kodsonsystems.com:8082

# --- PostgreSQL (matches postgresql-setup.sql / application.yaml) ---
# Inside Docker on Windows/Mac, use host.docker.internal to reach Postgres on the host.
# With docker-compose, use the postgres service name: jdbc:postgresql://postgres:5432/ktc_postgress
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/ktc_postgress
SPRING_DATASOURCE_USERNAME=ktc_kodson_user
SPRING_DATASOURCE_PASSWORD=your_password_here

# --- Production remote DB (only if SPRING_PROFILES_ACTIVE=prod) ---
# DATABASE_URL=jdbc:postgresql://host:5432/dbname
# DATABASE_USERNAME=ktc_kodson_user
# DATABASE_PASSWORD=your_password_here

# --- JWT ---
JWT_SECRET=your_jwt_secret_here

# --- Mail ---
MAIL_HOST=mail.kodsonplusltd.com
MAIL_PORT=587
MAIL_USERNAME=info@kodsonplusltd.com
MAIL_PASSWORD=your_mail_password_here
