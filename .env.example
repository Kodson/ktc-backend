# Copy to .env on Ubuntu. Postgres on host; backend: docker compose up -d --build

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8082
VERIFY_EMAIL_HOST=https://kodsonsystems.com:8082

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/ktc_postgress
SPRING_DATASOURCE_USERNAME=ktc_kodson_user
SPRING_DATASOURCE_PASSWORD=your_password_here

JWT_SECRET=your_jwt_secret_here

MAIL_HOST=mail.kodsonplusltd.com
MAIL_PORT=587
MAIL_USERNAME=info@kodsonplusltd.com
MAIL_PASSWORD=your_mail_password_here
